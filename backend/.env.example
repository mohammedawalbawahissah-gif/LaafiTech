DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — postgresql is the default (matches Railway production).
# Set DB_ENGINE=sqlite instead if you want zero local DB setup.
DB_ENGINE=postgresql
DB_NAME=laafitech
DB_USER=laafitech_admin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Resend
RESEND_API_KEY=

# MTN MoMo (native)
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENV=sandbox
MTN_MOMO_TARGET_ENV=sandbox

# Hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Anthropic (Claude API) - impact narratives + education assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
